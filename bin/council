#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "optparse"
require_relative "../lib/council"

USAGE = <<~TEXT
  Usage: bin/council build TICKET [--config FILE] [--ticket-file FILE] [--no-linear] [--dry-run]
         bin/council discard TICKET [--config FILE]
         bin/council plan --brief FILE --run-dir DIR [--publish] [--config FILE]
         bin/council cycle TICKET --run-dir DIR [--ticket-file FILE] [--lane engineer|platform] [--max-revisions 0|1] [--config FILE]
         bin/council qa TICKET --candidate-file FILE --run-dir DIR [--ticket-file FILE] [--lane engineer|platform] [--config FILE]
TEXT

options = {config: File.join(Council::ROOT, "config/council.json"), linear: true, max_revisions: 1}
parser = OptionParser.new do |opts|
  opts.banner = USAGE
  opts.on("--config FILE") { |value| options[:config] = value }
  opts.on("--ticket-file FILE") { |value| options[:ticket_file] = value }
  opts.on("--no-linear", "Leave Linear alone after landing") { options[:linear] = false }
  opts.on("--dry-run", "Say what would happen, and start nothing") { options[:dry_run] = true }
  opts.on("--brief FILE") { |value| options[:brief] = value }
  opts.on("--run-dir DIR") { |value| options[:run_dir] = value }
  opts.on("--publish", "Explicitly create the director's child tickets in Linear") { options[:publish] = true }
  opts.on("--candidate-file FILE") { |value| options[:candidate_file] = value }
  opts.on("--lane NAME") { |value| options[:lane] = value }
  opts.on("--max-revisions N", Integer) { |value| options[:max_revisions] = value }
end

begin
  parser.parse!(ARGV)
  command, id = ARGV.shift(2)
  abort USAGE unless %w[build discard plan cycle qa].include?(command)
  abort USAGE if %w[build discard cycle qa].include?(command) && !(id || options[:ticket_file])
  abort USAGE if %w[plan cycle qa].include?(command) && !options[:run_dir]
  abort USAGE if command == "plan" && !options[:brief]
  abort USAGE if command == "qa" && !options[:candidate_file]
  raise Council::Error, "--publish is only for plan and cannot use --no-linear" if options[:publish] && (command != "plan" || !options[:linear])
  config = Council::Config.load(options[:config])
  Council.boot(config)
  if command == "discard"
    Council::Builder.new(config, runner: nil).discard(id)
    exit
  end
  if command == "plan"
    brief = JSON.parse(File.read(options[:brief]))
    if options[:dry_run]
      puts JSON.pretty_generate("brief" => brief, "run_dir" => options[:run_dir], "publish" => !!options[:publish], "roles" => config.data["roles"])
      exit
    end
    role = Council::Role.new(config, name: "director", runner: Council.subscription_runner(config, role: "director"))
    result = Council::Director.new(config, role: role, linear: options[:publish] ? Council::Linear.new : nil).call(brief, run_dir: options[:run_dir], publish: !!options[:publish])
    puts JSON.pretty_generate(result)
    exit(result["status"] == "questions" ? 3 : 0)
  end
  ticket = %w[cycle qa].include?(command) && options[:ticket_file] ? JSON.parse(File.read(options[:ticket_file])) : Giraffe::Tickets.load(identifier: id, file: options[:ticket_file])
  raise Council::Error, "ticket file and identifier differ" if id && ticket["id"] != id
  if %w[cycle qa].include?(command)
    lane = options[:lane] || ticket["lane"] || "engineer"
    raise Council::Error, "invalid or mismatched lane" unless %w[engineer platform].include?(lane) && (!ticket["lane"] || ticket["lane"] == lane)
    raise Council::Error, "cycle requires explicit owned paths in config.allowed" unless config.data["allowed"].is_a?(Array) && config.data["allowed"].any?
    if options[:dry_run]
      puts JSON.pretty_generate("ticket" => ticket, "lane" => lane, "run_dir" => options[:run_dir], "allowed" => config["allowed"], "landing" => "review only; no push, merge, Done or deploy")
      exit
    end
    writer = Council::Builder.new(config, role: lane, runner: command == "qa" ? nil : Council.subscription_runner(config, role: lane))
    qa = Council::Role.new(config, name: "qa", runner: Council.subscription_runner(config, role: "qa"))
    cycle = Council::Cycle.new(builder: writer, qa: qa, run_dir: options[:run_dir], max_revisions: options[:max_revisions])
    result = if command == "qa"
      data = JSON.parse(File.read(options[:candidate_file]))
      candidate = Council::Builder::Candidate.new(**data.transform_keys(&:to_sym))
      cycle.review(ticket, candidate)
    else
      cycle.call(ticket)
    end
    puts JSON.pretty_generate(result)
    exit(result["status"] == "ready" ? 0 : 3)
  end
  if options[:dry_run]
    puts JSON.pretty_generate("ticket" => ticket.slice("id", "title", "url"), "game_repo" => config["game_repo"],
                              "worktree" => File.join(config["worktrees"], ticket["id"]), "builder" => config.builder,
                              "checks" => config.check_argv("<base>"), "lands_on" => config["branch"], "linear" => options[:linear])
    exit
  end
  linear = options[:linear] && (config["linear"]["done"] || config["linear"]["comment"]) ? Council::Linear.new : nil
  outcome = Council::Builder.new(config, runner: Council.subscription_runner(config), linear: linear).build(ticket)
  puts JSON.pretty_generate(outcome.to_h)
  exit(outcome.status == "landed" ? 0 : 3)
rescue StandardError => e
  # Giraffe's errors are known only once it has loaded.
  raise unless e.is_a?(Council::Error) || e.is_a?(JSON::ParserError) || e.is_a?(OptionParser::ParseError) || (defined?(Giraffe::Error) && e.is_a?(Giraffe::Error))
  warn "council: #{e.message}"
  exit 1
end
